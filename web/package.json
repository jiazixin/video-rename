{
  "name": "video-rename-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "check": "vue-tsc --noEmit",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{vue,css,ts}\"",
    "format:check": "prettier --check \"src/**/*.{vue,css,ts}\""
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "@lucide/vue": "1.52.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vite": "^8.3.3",
    "vue-tsc": "^3.3.12"
  }
}
